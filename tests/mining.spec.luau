local fs = require("@lune/fs")
assert(fs.isFile("src/server/MiningService.luau"), "MiningService not implemented")
local Mining = require("../src/server/MiningService")
local config = {Health=3, Damage=1, HitInterval=1, RespawnTime=5, Reward=10, MaxDistance=20,
    Nodes={a={x=0,y=0,z=0},b={x=5,y=0,z=0}}}
local rewards={}
local m=Mining.new(config,function(uid,amount) rewards[uid]=(rewards[uid] or 0)+amount; return true end)
m:open(1); m:open(2)
assert(not m:select(1,"bad",0,0,true))
assert(not m:select(1,"a",0,21,true))
assert(not m:select(1,"a",0,0,false))
assert(m:select(1,"a",0,0,true))
assert(m:select(1,"a",0.5,0,true)) -- repeat selection must not delay next hit
m:tick(1,1,0,true)
assert(m:snapshot(1).nodes.a.health==2)
assert(m:snapshot(2).nodes.a.health==3)
m:tick(1,1,0,true)
assert(m:snapshot(1).nodes.a.health==2)
m:select(1,"b",1,0,true)
m:tick(1,2,0,true)
assert(m:snapshot(1).nodes.b.health==2 and m:snapshot(1).nodes.a.health==2)
m:recall(1); m:tick(1,3,0,true)
assert(m:snapshot(1).nodes.b.health==2)
m:select(1,"a",3,0,true); m:tick(1,4,21,true)
assert(m:snapshot(1).targetId==nil and m:snapshot(1).nodes.a.health==2)
m:select(1,"a",5,0,true); m:tick(1,6,0,true); m:tick(1,7,0,true)
assert(rewards[1]==10 and m:snapshot(1).nodes.a.health==0)
m:tick(1,7,0,true); assert(rewards[1]==10)
assert(not m:select(1,"a",8,0,true))
m:tick(1,12,0,true); assert(m:snapshot(1).nodes.a.health==3)
assert(m:select(1,"a",12,0,true))
m:tick(1,13,0,false); assert(m:snapshot(1).targetId==nil)
m:close(1); assert(m:snapshot(1)==nil)
print("PASS mining: personal state, switch, recall, distance, cooldown, one reward, respawn, no team, cleanup")
local Store=require("../src/server/ProfileStore")
local profiles=Store.new({TeamLimit=1,CollectionLimit=1,SchemaVersion=1,RequestInterval=.15,Species={prototype=true},StarterSpeciesId="prototype"},function() return "starter" end)
profiles:open(1)
local integrated=Mining.new(config,function(uid,amount) return profiles:awardCrystals(uid,amount) end)
integrated:open(1); integrated:select(1,"a",0,0,true)
for time=1,4 do integrated:tick(1,time,0,true) end
assert(profiles:snapshot(1).profile.Resources.Crystals==10)
assert(not profiles:awardCrystals(1,-10) and not profiles:awardCrystals(1,math.huge))
assert(not profiles:awardCrystals(99,10))
print("PASS mining/profile integration: one real reward and invalid amounts rejected")
