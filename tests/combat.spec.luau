local fs=require("@lune/fs")
assert(fs.isFile("src/server/CombatService.luau"),"CombatService not implemented")
local Combat=require("../src/server/CombatService")
local c={PetHP=20,EnemyHP=15,PetDamage=8,EnemyDamage=12,PlayerDamage=5,Interval=1,Rest=4,Respawn=5,Range=25,PlayerAttackRange=5}
local s=Combat.new(c)
s:open(1); s:open(2); s:syncTeam(1,{"p"}); s:syncTeam(2,{"q"})
assert(not s:select(1,0,30,true))
assert(s:select(1,0,10,true))
s:tick(1,1,10,true); assert(s:snapshot(1).pets.p.hp==8)
assert(s:snapshot(2).enemyHP==15)
s:tick(1,2,10,true); assert(s:snapshot(1).enemyHP==0)
s:tick(1,2,10,true); assert(s:snapshot(1).enemyHP==0)
s:tick(1,7,10,true); assert(s:snapshot(1).enemyHP==15)
s:select(1,7,10,true); s:recall(1); s:tick(1,8,10,true); assert(s:snapshot(1).enemyHP==15)
s:select(1,8,10,true); s:tick(1,9,30,true); assert(not s:snapshot(1).active)
local strong=table.clone(c); strong.EnemyHP=100
local loss=Combat.new(strong); loss:open(1); loss:syncTeam(1,{"p"}); loss:select(1,0,10,true)
loss:tick(1,1,10,true); loss:tick(1,2,10,true)
assert(loss:snapshot(1).pets.p.hp==0 and not loss:snapshot(1).active)
loss:tick(1,6,10,true); assert(loss:snapshot(1).pets.p.hp==20)
local _,damage=loss:tick(1,7,3,true); assert(damage==5)
loss:close(1); assert(loss:snapshot(1)==nil)
print("PASS combat: HP, victory, defeat/rest, range, recall, isolation, player damage")
local Merchant=require("../src/server/MerchantService")
local m=Merchant.new(10)
assert(not m:act(1,"TradeMerchant",2,true))
assert(not m:act(1,"TalkMerchant",11,true))
assert(m:act(1,"TalkMerchant",2,true)); assert(m:snapshot(1).page=="Greeting")
assert(m:act(1,"TradeMerchant",2,true)); assert(m:snapshot(1).page=="Shop" and #m:snapshot(1).offers==0)
assert(m:snapshot(2).page==nil)
assert(m:act(1,"LeaveMerchant",100,false)); assert(m:snapshot(1).page==nil)
print("PASS merchant: distance, sequence, empty offers, leave, isolation")
