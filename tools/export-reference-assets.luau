local fs=require('@lune/fs')
local rb=require('@lune/roblox')
local Models=require('../src/shared/ReferenceModels')
local Scene=require('../src/server/SceneBuilder')
local maker=Models.new(rb)
local folder=rb.Instance.new('Folder')
local pet=maker:pet(folder)
local ore=maker:ore(folder)
local enemy=maker:enemy(folder)
local world=rb.Instance.new('Workspace')
local scene=Scene.build(world,nil,rb)
fs.writeFile('assets/MossCompanion.rbxm',rb.serializeModel({pet}))
fs.writeFile('assets/CopperOutcrop.rbxm',rb.serializeModel({ore}))
fs.writeFile('assets/Penkun.rbxm',rb.serializeModel({enemy}))
fs.writeFile('assets/ReferenceWorld.rbxm',rb.serializeModel({scene}))
print('Exported four editable reference models to assets/')
